{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "vllm": {
      "class": "vllm.logging_utils.NewLineFormatter",
      "datefmt": "%m-%d %H:%M:%S",
      "format": "%(levelname)s %(asctime)s [%(fileinfo)s:%(lineno)d] %(message)s"
    }
  },
  "handlers": {
    "vllm": {
      "class": "logging.StreamHandler",
      "formatter": "vllm",
      "level": "DEBUG",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "vllm": {
      "handlers": [
        "vllm"
      ],
      "level": "INFO",
      "propagate": false
    },
    "vllm_omni.config.live_session": {
      "level": "DEBUG"
    },
    "vllm_omni.config.omni_config": {
      "level": "DEBUG"
    },
    "vllm_omni.config.stage_config": {
      "level": "DEBUG"
    },
    "vllm_omni.engine.messages": {
      "level": "DEBUG"
    },
    "vllm_omni.engine.orchestrator": {
      "level": "DEBUG"
    },
    "vllm_omni.entrypoints.omni_base": {
      "level": "DEBUG"
    },
    "vllm_omni.entrypoints.openai.api_server": {
      "level": "DEBUG"
    },
    "vllm_omni.entrypoints.openai.live": {
      "level": "DEBUG"
    },
    "vllm_omni.metrics.definitions": {
      "level": "DEBUG"
    },
    "vllm_omni.metrics.live": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.minicpmo_4_5.live": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.minicpmo_4_5.minicpmo_4_5_omni": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.minicpmo_4_5.minicpmo_4_5_omni_llm": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.minicpmo_4_5.minicpmo_4_5_omni_tts": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.minicpmo_4_5.pipeline": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.personaplex.duplex.config": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.personaplex.duplex.policy": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.personaplex.duplex.stage0": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.personaplex.live": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.personaplex.personaplex_talker": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.personaplex.pipeline": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.models.personaplex.prompting": {
      "level": "DEBUG"
    },
    "vllm_omni.model_executor.stage_input_processors.minicpmo_4_5_omni": {
      "level": "DEBUG"
    },
    "vllm_omni.outputs": {
      "level": "DEBUG"
    }
  }
}
